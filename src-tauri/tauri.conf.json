{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Music Cut",
  "version": "0.58.0",
  "identifier": "net.markkulab.aimusiccut",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Music Cut",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "visible": false,
        "backgroundColor": "#2F303B",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/ffmpeg/*": "resources/ffmpeg/"
    },
    "licenseFile": "../THIRD-PARTY-NOTICES.txt",
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg"
        ]
      },
      "rpm": {
        "depends": [
          "ffmpeg"
        ]
      }
    }
  }
}
