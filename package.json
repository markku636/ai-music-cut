{
  "name": "ai-music-cut",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "description": "AI podcast rough-cut desktop tool — filler/stutter removal, loudness leveling, AI review suggestions",
  "scripts": {
    "dev": "vite",
    "build": "tsc && eslint src && vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint src && vitest run && node scripts/check-secrets.mjs",
    "tauri": "tauri",
    "make:app-icon": "node scripts/make-app-icon.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "aicut": "node dist-cli/aicut.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wavesurfer.js": "7.12.11",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.41",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.62.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.9"
  },
  "bin": {
    "aicut": "dist-cli/aicut.mjs"
  }
}
